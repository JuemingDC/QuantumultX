#!name = 趣智校园去广告
#!desc = 隐藏首页提现/零花钱模块、任务广告横幅、下方广告卡片，并拦截相关广告 SDK
#!author = Magdalena
#!date = 2026-09-17

# 兜底拦截趣智校园抓包中实际出现的第三方广告服务
host, ad.shunchangzhixing.com, reject
host, inner.shunchangzhixing.com, reject
host, inner-hw.huazirc.com, reject
host, ad.lovefree.cc, reject
host, ax.admobile.top, reject
host, api.track.admobile.top, reject
host, img.admobile.top, reject
host, sdk.tianmu.mobi, reject
host, tracker.tianmu.mobi, reject
host, event.mvpmob.com, reject
host, e.api.adwanji.com, reject
host, s.tuia.cn, reject

# 清空首页广告链
^https:\/\/v3-api\.china-qzxy\.cn\/project\/adv\/chain\/get url jsonjq-response-body '.data = []'

# 清空广告 SDK 的全部广告位 ID
^https:\/\/v3-api\.china-qzxy\.cn\/project\/advSpace\/app\/v2\/list url jsonjq-response-body '.data.openAdvId = "" | .data.cutAdvId = "" | .data.nativeAdvId = "" | .data.feedAdvId = "" | .data.feedGroupAdvId = "" | .data.jutuiIconAdvId = "" | .data.jutuiFloatAdvId = "" | .data.jutuiTextLinkAdvId = "" | .data.yifanTextLinkAdvId = "" | .data.commandAdvStr = ""'

# 将当前项目 3118 加入任务广告黑名单，并移除任务图
^https:\/\/v3-api\.china-qzxy\.cn\/project\/info\/triple url jsonjq-response-body '.data.clientProjectInfoSwitchDTO.appAdvertiseSwitch = 0 | .data.clientProjectInfoSwitchDTO.screenAdvertisingSwitch = 0 | .data.clientProjectInfoSwitchDTO.jobAdvertisingSwitch = 0 | .data.clientProjectInfoSwitchDTO.contentModuleSwitch = 0 | .data.clientProjectInfoConfigDTO.appAdvertiseLevel = 0 | .data.clientProjectInfoConfigDTO.taskImg = null | .data.clientProjectInfoConfigDTO.taskAdvertiseProjectBlackList = "3118,3170,3454"'

# 整体隐藏“每天赚（省）点零花钱 / 可提现金”模块
^https:\/\/v3-api\.china-qzxy\.cn\/user\/coin\/info\/withAppAdvChannel url jsonjq-response-body '.data = null'

# 清空霸王餐/免费餐推广数据
^https:\/\/v3-api\.china-qzxy\.cn\/settlement\/advertise\/freeMeal\/activity\/index url jsonjq-response-body '.data.amount = 0 | .data.activityList = []'

# 拦截服务端任务广告素材
^https:\/\/oss\.china-qzxy\.cn\/qzxy_images\/adv\/ url reject-img

hostname = v3-api.china-qzxy.cn, oss.china-qzxy.cn
